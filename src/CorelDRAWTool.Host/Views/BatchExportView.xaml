<UserControl x:Class="CorelDRAWTool.Host.Views.BatchExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1D4ED8" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F9FAFB" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FolderTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </UserControl.Resources>

  <Border Background="White"
          CornerRadius="10"
          BorderBrush="#E5E7EB"
          BorderThickness="1"
          Padding="22">
    <StackPanel>
      <TextBlock Text="批量导出 PDF"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="#111827" />
      <TextBlock Text="选择一个文件夹，把其中的 .cdr 逐个导出为 PDF。导出使用文档副本，不会修改源文件；导出期间请勿在 CorelDRAW 中操作当前文档。"
                 FontSize="12"
                 Foreground="#6B7280"
                 Margin="0,6,0,4"
                 TextWrapping="Wrap" />

      <TextBlock Text="输入文件夹" Style="{StaticResource FieldLabelStyle}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FolderTextBoxStyle}"
                 AutomationProperties.AutomationId="InputFolderBox"
                 AutomationProperties.Name="输入文件夹" />
        <Button Grid.Column="1"
                Content="浏览"
                Command="{Binding BrowseInputCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Padding="14,6"
                Margin="8,0,0,0" />
      </Grid>

      <TextBlock Text="输出文件夹" Style="{StaticResource FieldLabelStyle}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FolderTextBoxStyle}"
                 AutomationProperties.AutomationId="OutputFolderBox"
                 AutomationProperties.Name="输出文件夹" />
        <Button Grid.Column="1"
                Content="浏览"
                Command="{Binding BrowseOutputCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Padding="14,6"
                Margin="8,0,0,0" />
      </Grid>

      <CheckBox Content="覆盖已存在的 PDF"
                IsChecked="{Binding OverwriteExisting}"
                Margin="0,16,0,0"
                FontSize="12"
                Foreground="#374151" />

      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
        <Button Content="开始导出"
                Command="{Binding StartCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                AutomationProperties.AutomationId="StartBatchExportButton" />
        <Button Content="取消"
                Command="{Binding CancelCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="10,0,0,0"
                AutomationProperties.AutomationId="CancelBatchExportButton" />
      </StackPanel>

      <ProgressBar Height="6"
                   Margin="0,20,0,0"
                   Value="{Binding ProgressValue, Mode=OneWay}"
                   Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                   Foreground="#2563EB"
                   Background="#E5E7EB"
                   BorderThickness="0" />

      <TextBlock Text="{Binding StatusText}"
                 FontSize="12"
                 Foreground="#4B5563"
                 Margin="0,10,0,0"
                 TextWrapping="Wrap" />

      <TextBlock Text="文件"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="#6B7280"
                 Margin="0,20,0,6" />

      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="文件" FontSize="10" Foreground="#9CA3AF" />
        <TextBlock Grid.Column="1" Text="状态" FontSize="10" Foreground="#9CA3AF" />
        <TextBlock Grid.Column="2" Text="说明" FontSize="10" Foreground="#9CA3AF" />
      </Grid>

      <Border BorderBrush="#E5E7EB"
              BorderThickness="1"
              CornerRadius="6"
              Background="#F9FAFB"
              Padding="10">
        <ScrollViewer MaxHeight="220"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="{Binding FileName}"
                             FontSize="12"
                             Foreground="#111827"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding SourcePath}" />

                  <TextBlock Grid.Column="1"
                             Text="{Binding Status}"
                             FontSize="12"
                             FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#6B7280" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="成功">
                            <Setter Property="Foreground" Value="#16A34A" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="失败">
                            <Setter Property="Foreground" Value="#DC2626" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="导出中">
                            <Setter Property="Foreground" Value="#2563EB" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="已跳过">
                            <Setter Property="Foreground" Value="#9CA3AF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <TextBlock Grid.Column="2"
                             Text="{Binding Detail}"
                             FontSize="11"
                             Foreground="#9CA3AF"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Detail}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
