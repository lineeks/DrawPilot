<Window x:Class="DrawPilot.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DrawPilot.Host.Views"
        Title="DrawPilot"
        Height="720"
        Width="1100"
        MinHeight="580"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1D4ED8" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F9FAFB" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6B7280" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#1F2937">
      <Grid Margin="28,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DrawPilot"
                     Foreground="White"
                     FontSize="22"
                     FontWeight="SemiBold" />
          <TextBlock Text="CorelDRAW 2025 · 内部效率工具"
                     Foreground="#9CA3AF"
                     FontSize="12"
                     Margin="0,2,0,0" />
        </StackPanel>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#111827"
                CornerRadius="14"
                Padding="14,7">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="#EF4444" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Fill" Value="#22C55E" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionLabel}"
                       Foreground="#D1D5DB"
                       FontSize="12"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="功能"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#6B7280"
                     Margin="8,4,8,8" />

          <ListBox ItemsSource="{Binding Features}"
                   SelectedItem="{Binding SelectedFeature, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ItemBorder"
                              Background="Transparent"
                              CornerRadius="7"
                              Padding="10,8">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding CategoryLabel}"
                               FontSize="10"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right"
                            Background="#F3F4F6"
                            CornerRadius="4"
                            Padding="6,1">
                      <TextBlock Text="{Binding AvailabilityLabel}"
                                 FontSize="9"
                                 Foreground="#6B7280" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="#111827"
                             Margin="0,3,0,2" />
                  <TextBlock Text="{Binding Description}"
                             FontSize="11"
                             Foreground="#6B7280"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="20,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDocumentInfoSelected}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="文档信息"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#6B7280" />
                  <TextBlock Text="{Binding DocumentInfo.DisplayName}"
                             FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="#111827"
                             Margin="0,6,0,2" />
                  <TextBlock Text="{Binding DocumentInfo.FileLocation}"
                             FontSize="12"
                             Foreground="#6B7280"
                             TextWrapping="Wrap" />

                  <UniformGrid Columns="3" Margin="0,24,0,0">
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="页面数" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DocumentInfo.PageCount}" Style="{StaticResource MetricValueStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="图层数" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DocumentInfo.LayerCount}" Style="{StaticResource MetricValueStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="14">
                      <StackPanel>
                        <TextBlock Text="选中对象" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DocumentInfo.SelectionCount}" Style="{StaticResource MetricValueStyle}" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <Border Height="1" Background="#E5E7EB" Margin="0,24,0,20" />

                  <TextBlock Text="CorelDRAW 连接"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#6B7280" />

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="版本"
                               FontSize="12"
                               Foreground="#6B7280" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding ApplicationInfo.DisplayVersion}"
                               FontSize="12"
                               Foreground="#111827" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="安装路径"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding ApplicationInfo.ProgramPath}"
                               FontSize="12"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="插入测试矩形"
                            Command="{Binding InsertTestRectangleCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="12,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBatchExportSelected}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <views:BatchExportView DataContext="{Binding BatchExport}" />
            </StackPanel>

            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaceholderVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="{Binding PlaceholderTitle}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="#111827" />
                  <TextBlock Text="{Binding PlaceholderText}"
                             FontSize="13"
                             Foreground="#6B7280"
                             Margin="0,10,0,0"
                             TextWrapping="Wrap" />
                  <Border Background="#F9FAFB"
                          CornerRadius="8"
                          Padding="16"
                          Margin="0,28,0,0">
                    <TextBlock Text="该功能已在功能清单中登记，后续迭代会在这里补上完整界面和 CorelDRAW 操作。"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="14,10"
                Margin="0,14,0,0">
          <TextBlock Text="{Binding StatusText}"
                     FontSize="12"
                     Foreground="#4B5563"
                     TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
